{
  "name": "nes-blum-factory",
  "productName": "NES BLUM FACTORY",
  "version": "1.3.0",
  "private": true,
  "description": "Studio de création de jeux NES par directeurs IA. Cadeau pour Blum.",
  "license": "UNLICENSED",
  "main": "dist/electron/main/main.js",
  "scripts": {
    "dev:renderer": "vite --config vite.config.mts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build --config vite.config.mts",
    "start": "npm run build && electron .",
    "test": "vitest run --config vitest.config.mts",
    "smoke": "node scripts/smoke.mjs",
    "gate": "npm run build && npm test && npm run smoke",
    "fetch:toolchain": "node scripts/fetch-toolchain.mjs",
    "test:engine": "node scripts/test-engine.mjs",
    "test:mesen": "node scripts/test-mesen.mjs",
    "test:racer-mesen": "node scripts/racer-mesen.mjs",
    "test:rpg-mesen": "node scripts/rpg-mesen.mjs",
    "test:legend-mesen": "node scripts/legend-mesen.mjs",
    "legend:kit": "node scripts/import-legend-kit.mjs",
    "legend:soak": "node scripts/legend-soak.mjs",
    "legend:handover": "node scripts/legend-handover.mjs",
    "soundtrack": "node scripts/soundtrack.mjs",
    "racer:handover": "node scripts/racer-handover.mjs",
    "racer:kit": "node scripts/import-sebring-kit.mjs",
    "racer:soak": "node scripts/racer-soak.mjs",
    "music:compose": "node scripts/music/compose.mjs",
    "music:export": "node scripts/music/export.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "package": "node scripts/package.mjs",
    "test:package": "node scripts/test-package.mjs",
    "gift": "node scripts/gift.mjs",
    "sample": "node scripts/make-sample.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "fflate": "^0.8.3",
    "jsnes": "^2.1.0",
    "zod": "^4.6.7"
  },
  "author": "Fred (NUVoize)"
}
